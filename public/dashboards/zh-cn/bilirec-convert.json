{
  "title": "bilirec / 转码健康",
  "uid": "bilirec-convert",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "bilirec"
  ],
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "id": null,
  "description": "转码队列有没有积压、失败尝试是否突然变多，以及 FFmpeg 与 CloudConvert 各处理了多少。「失败」按尝试次数计，重试会重复累加。CloudConvert 的「待处理」是尚未成功提交到云端，「处理中」是已提交但仍在云端等待、执行或下载结果。码率与录制请看「录制总览」或「录制健康」。",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "数据源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "type": "query",
        "label": "job",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total, job)",
        "definition": "label_values(bilirec_convert_tasks_queued_total, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "label": "instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\"}, instance)",
        "definition": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\"}, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "type": "query",
        "label": "provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\"}, provider)",
        "definition": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\"}, provider)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "bilirec"
      ],
      "targetBlank": false,
      "title": "bilirec",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "现状",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "处理中",
      "description": "当前仍在处理生命周期中的任务数。FFmpeg 表示正在转码；CloudConvert 表示已提交到云端但仍保留在持久化队列中的任务，包含云端等待、执行及结果下载处理。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}) or vector(0)",
          "legendFormat": "处理中",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "待处理",
      "description": "当前仍在本机等待下一步动作的任务数。FFmpeg 是尚未开始或等待重试的任务；CloudConvert 是尚未成功提交到云端的任务。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}) or vector(0)",
          "legendFormat": "待处理",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "入队",
      "description": "所选时间区间内成功写入转码队列的任务数。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "入队",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "完成",
      "description": "所选时间区间内成功完成的转码任务数。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "完成",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "失败尝试",
      "description": "所选时间区间内转码或相关处理失败的次数。任务重试时可能重复计数，因此不一定等于唯一失败任务数。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "失败",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "取消",
      "description": "所选时间区间内由使用者取消、并成功从队列移除的任务数。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_cancelled_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "取消",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "积压与失败率",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "stat",
      "title": "区间失败率",
      "description": "失败尝试 ÷（完成 + 失败尝试）。分母不含取消。重试会抬高此值，不等于唯一任务失败比例。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)) / clamp_min((sum(increase(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)) + (sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)), 1)",
          "legendFormat": "失败率",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "FFmpeg 积压",
      "description": "当前 FFmpeg 待处理 + 处理中。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=\"ffmpeg\"}) or vector(0)) + (sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=\"ffmpeg\"}) or vector(0))",
          "legendFormat": "FFmpeg",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "CloudConvert 积压",
      "description": "当前 CloudConvert 待处理 + 处理中（含已提交云端尚未结束）。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=\"cloudconvert\"}) or vector(0)) + (sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=\"cloudconvert\"}) or vector(0))",
          "legendFormat": "CloudConvert",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "各实例积压",
      "description": "按 instance、provider 看当前待处理与处理中。没任务时为空表。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, provider) (bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, provider) (bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "processing"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "provider",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "filterable": true
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "趋势",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "待处理与处理中",
      "description": "按 provider 显示等待下一步动作及仍在处理生命周期中的任务数。CloudConvert 的处理中包括云端等待、执行及结果下载处理。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "{{provider}} / 待处理"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "{{provider}} / 处理中"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "入队速率（按 provider）",
      "description": "成功写入转码队列的平均速率。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 3,
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "处理结果速率",
      "description": "按 provider 与结果显示每秒平均事件数。失败按尝试次数计数，重试可能让同一任务出现多次失败。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 完成"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 失败"
        },
        {
          "refId": "C",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_cancelled_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 取消"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 3,
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "完成$"
            },
            "properties": [
              {
                "id": "color",

{
    "title": "bilirec / 单房间详情",
    "uid": "bilirec-room",
    "schemaVersion": 39,
    "version": 2,
    "refresh": "30s",
    "tags": ["bilirec"],
    "timezone": "browser",
    "graphTooltip": 1,
    "editable": true,
    "id": null,
    "description": "单一房间的开播/录制时间线、读入与落盘速率，以及 Grafana 时间范围内的弹幕、落盘量、录制时长与次数。写入管线可看队列等待、慢 flush/fsync 与 FLV 时间戳跳变。房间下拉显示主播名，实际值仍是 room_id。",
    "time": { "from": "now-24h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "label": "数据源",
          "hide": 0,
          "refresh": 1,
          "includeAll": false,
          "multi": false
        },
        {
          "name": "job",
          "type": "query",
          "label": "job",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(bilirec_active_recordings, job)",
          "definition": "label_values(bilirec_active_recordings, job)",
          "includeAll": true,
          "multi": true,
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "instance",
          "type": "query",
          "label": "instance",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(bilirec_active_recordings{job=~\"$job\"}, instance)",
          "definition": "label_values(bilirec_active_recordings{job=~\"$job\"}, instance)",
          "includeAll": true,
          "multi": true,
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "room_id",
          "type": "query",
          "label": "房间",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "query_result(max by (room_id, uname) (bilirec_room_info{job=~\"$job\", instance=~\"$instance\"}))",
          "definition": "query_result(max by (room_id, uname) (bilirec_room_info{job=~\"$job\", instance=~\"$instance\"}))",
          "regex": "/room_id=\"(?<value>[^\"]+)\".*uname=\"(?<text>[^\"]+)\"/",
          "includeAll": false,
          "multi": false,
          "refresh": 2,
          "sort": 1,
          "current": {}
        }
      ]
    },
    "links": [
      {
        "asDropdown": true,
        "icon": "dashboard",
        "includeVars": true,
        "keepTime": true,
        "tags": ["bilirec"],
        "targetBlank": false,
        "title": "bilirec",
        "tooltip": "",
        "type": "dashboards"
      }
    ],
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "本区间累计",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 2,
        "type": "stat",
        "title": "主播",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "max by (uname) (bilirec_room_info{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "{{uname}}",
            "instant": false,
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "displayName": "${__field.labels.uname}",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "name",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "弹幕条数",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_danmaku_messages_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "弹幕",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "读入 / 落盘",
        "description": "这段时间 TCP 读入与写入器实际写出的字节。落盘通常略小于读入。",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "读入",
            "instant": true,
            "range": false
          },
          {
            "refId": "B",
            "expr": "sum(increase(bilirec_room_stream_bytes_written_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "落盘",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "录制时长",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(integrate(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "录制",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "dtdurations",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "录制次数",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_room_recording_sessions_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "次数",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "断线恢复",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_room_stream_recovery_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__range])) or vector(0)",
            "legendFormat": "恢复",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 8,
        "type": "row",
        "title": "状态时间线",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 9,
        "type": "state-timeline",
        "title": "开播 / 录制 / 连接 / 弹幕",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "max(bilirec_room_live_status{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "开播"
          },
          {
            "refId": "B",
            "expr": "max(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "录制"
          },
          {
            "refId": "C",
            "expr": "max(bilirec_room_stream_connection_active{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "流连接"
          },
          {
            "refId": "D",
            "expr": "max(bilirec_danmaku_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "弹幕录制"
          },
          {
            "refId": "E",
            "expr": "max(bilirec_danmaku_connection_active{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"})",
            "legendFormat": "弹幕连接"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "fillOpacity": 70, "lineWidth": 0, "spanNulls": false },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "color": "transparent", "index": 0, "text": "否" },
                  "1": { "color": "green", "index": 1, "text": "是" }
                }
              }
            ]
          }
        },
        "options": {
          "alignValue": "center",
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "mergeValues": true,
          "rowHeight": 0.9,
          "showValue": "never",
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "读取与弹幕",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "直播流读取 / 落盘速率",
        "description": "读入是 TCP 收到的字节；落盘是写入器实际写出。落盘持续低于读入，表示写入队列在积压。",
        "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "读入"
          },
          {
            "refId": "B",
            "expr": "sum(rate(bilirec_room_stream_bytes_written_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "落盘"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "spanNulls": false, "showPoints": "never" }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "弹幕事件速率",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (event_type) (rate(bilirec_danmaku_messages_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "{{event_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cps",
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "spanNulls": false, "showPoints": "never" }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 15,
        "type": "row",
        "title": "写入管线",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 16,
        "type": "timeseries",
        "title": "写入队列等待",
        "description": "写入队列已满时发送端等待的次数与累计秒数。持续出现表示磁盘或写入跟不上码率。",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(bilirec_room_stream_enqueue_waits_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "等待次数"
          },
          {
            "refId": "B",
            "expr": "sum(rate(bilirec_room_stream_enqueue_wait_seconds_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "等待秒数"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "spanNulls": false, "showPoints": "never", "axisSoftMin": 0 }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "等待次数" },
              "properties": [{ "id": "unit", "value": "ops" }]
            },
            {
              "matcher": { "id": "byName", "options": "等待秒数" },
              "properties": [{ "id": "unit", "value": "ops" }]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 17,
        "type": "timeseries",
        "title": "慢 flush / fsync",
        "description": "周期性或关闭时 flush 超过 3 秒、fsync 超过 1.2 秒的次数。切档关闭大档时也可能短暂出现。",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(bilirec_room_stream_slow_flushes_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "慢 flush"
          },
          {
            "refId": "B",
            "expr": "sum(rate(bilirec_room_stream_slow_syncs_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "慢 fsync"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "unit": "ops",
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "spanNulls": false, "showPoints": "never", "axisSoftMin": 0 }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 18,
        "type": "timeseries",
        "title": "FLV 时间戳跳变",
        "description": "正跳变次数，以及折叠掉的媒体时间。常见于源流断续或画质切换。",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(bilirec_room_stream_timestamp_jumps_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "跳变次数"
          },
          {
            "refId": "B",
            "expr": "sum(rate(bilirec_room_stream_timestamp_jump_collapsed_seconds_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "折叠秒数"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "spanNulls": false, "showPoints": "never", "axisSoftMin": 0 }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "跳变次数" },
              "properties": [{ "id": "unit", "value": "ops" }]
            },
            {
              "matcher": { "id": "byName", "options": "折叠秒数" },
              "properties": [{ "id": "unit", "value": "ops" }]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 13,
        "type": "row",
        "title": "场次与恢复",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 14,
        "type": "timeseries",
        "title": "开播场次 / 录制次数 / 断线恢复",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_room_live_sessions_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "开播场次"
          },
          {
            "refId": "B",
            "expr": "sum(increase(bilirec_room_recording_sessions_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "录制次数"
          },
          {
            "refId": "C",
            "expr": "sum(increase(bilirec_room_stream_recovery_total{job=~\"$job\", instance=~\"$instance\", room_id=\"$room_id\"}[$__rate_interval]))",
            "legendFormat": "断线恢复"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineInterpolation": "linear", "spanNulls": false, "showPoints": "never", "stacking": { "group": "A", "mode": "none" } }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      }
    ]
  }
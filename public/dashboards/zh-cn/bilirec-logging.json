{
  "title": "bilirec / 日志分析",
  "uid": "bilirec-logging",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "bilirec",
    "logging",
    "victorialogs"
  ],
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "id": null,
  "description": "bilirec VictoriaLogs 日志分析。房间、模块、级别与主机可多选组合，并可用搜索栏输入额外 LogsQL 条件；原始日志浏览请使用 bilirec-logs-explorer。",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "label": "日志数据源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "metricsDatasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "指标数据源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "room",
        "type": "query",
        "label": "房间",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "room",
          "query": "app:bilirec room:*",
          "limit": 500
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "logger",
        "type": "query",
        "label": "模块",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "logger",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "level",
        "type": "query",
        "label": "级别",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "level",
          "query": "app:bilirec room:in($room)",
          "limit": 50
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "type": "query",
        "label": "主机",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "instance",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "搜索（LogsQL）",
        "hide": 0,
        "description": "可输入额外的 LogsQL 条件，例如 error、file:xxx 或 processor:convert。",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "bilirec"
      ],
      "targetBlank": false,
      "title": "bilirec",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "总览",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "选定范围日志",
      "description": "按顶栏房间、模块、级别、主机与搜索条件统计。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:in($logger) level:in($level) instance:in($instance) $search | stats count() as count",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "错误日志",

{
  "title": "bilirec / 日誌瀏覽",
  "uid": "bilirec-logs-explorer",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "bilirec",
    "logging",
    "victorialogs",
    "explorer"
  ],
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "id": null,
  "description": "專注查看 VictoriaLogs 原始日誌，並按房間、模組、級別、主機與 LogsQL 欄位條件組合過濾；專題視窗依異常、錄製恢復、轉碼與檔案寫入整理日誌內容。",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "label": "資料源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "log_filter",
        "type": "adhoc",
        "label": "LogsQL 欄位",
        "hide": 0,
        "description": "用欄位、運算子和值建立 LogsQL 過濾條件；會套用到原始日誌與所有專題日誌面板。",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "filters": [],
        "skipUrlSync": false
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "完整 LogsQL",
        "hide": 0,
        "description": "全域 LogsQL 過濾列：輸入額外的完整 LogsQL 條件，例如 error、file:xxx 或 processor:convert；按 Enter 或離開輸入框後套用到所有日誌面板。",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        },
        "skipUrlSync": false
      },
      {
        "name": "room",
        "type": "query",
        "label": "房間",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "room",
          "query": "app:bilirec",
          "limit": 500
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "logger",
        "type": "query",
        "label": "模組",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "logger",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "level",
        "type": "query",
        "label": "級別",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "level",
          "query": "app:bilirec room:in($room)",
          "limit": 50
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "type": "query",
        "label": "主機",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "instance",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "bilirec"
      ],
      "targetBlank": false,
      "title": "bilirec",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "原始日誌",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "logs",
      "title": "原始日誌明細",
      "description": "依頂欄房間、模組、級別、主機選單與 LogsQL 過濾條件顯示最近日誌；欄位名稱搜尋已關閉，請直接在 LogsQL 過濾列輸入欄位條件。",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:in($logger) level:in($level) instance:in($instance) $search",
          "adHocFiltersMode": "extraFilters",
          "queryType": "instant",
          "maxLines": 2000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showFieldSelector": false,
        "showLabels": true,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "timestampResolution": "ms",
        "unwrappedColumns": false,
        "wrapLogMessage": false
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "專題日誌內容",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "logs",
      "title": "異常與警告內容",
      "description": "集中顯示 error、warn 與 warning 日誌；套用頂欄房間、模組、主機與 LogsQL 過濾條件。",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:in($logger) level:(error OR warn OR warning) instance:in($instance) $search",
          "adHocFiltersMode": "extraFilters",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showFieldSelector": false,
        "showLabels": true,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "timestampResolution": "ms",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "錄製、輪轉與斷線恢復",
      "description": "顯示 recorder 模組的實際日誌內容，用於追查開錄、分段輪轉、停止與直播流恢復；套用頂欄房間、級別、主機與 LogsQL 過濾條件。",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:recorder level:in($level) instance:in($instance) $search",
          "adHocFiltersMode": "extraFilters",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showFieldSelector": false,
        "showLabels": true,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "timestampResolution": "ms",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "轉碼任務內容",
      "description": "顯示 convert 模組的任務提交、處理、完成、延後與失敗內容；可展開 task_id 等結構化欄位，並套用頂欄房間、級別、主機與 LogsQL 過濾條件。",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:convert level:in($level) instance:in($instance) $search",
          "adHocFiltersMode": "extraFilters",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showFieldSelector": false,
        "showLabels": true,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "timestampResolution": "ms",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "檔案寫入與儲存內容",
      "description": "只顯示帶有 file 結構化欄位的日誌，方便追查建立、寫入、flush、sync、頁面快取與檔案路徑問題；套用所有頂欄過濾條件。",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) file:* logger:in($logger) level:in($level) instance:in($instance) $search",
          "adHocFiltersMode": "extraFilters",
          "queryType": "instant",
          "maxLines": 1000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showFieldSelector": false,
        "showLabels": true,
        "showLevel": true,
        "showTime": true,
        "sortOrder": "Descending",
        "timestampResolution": "ms",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      }
    }
  ]
}

{
  "title": "bilirec / 日誌分析",
  "uid": "bilirec-logging",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "bilirec",
    "logging",
    "victorialogs"
  ],
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "id": null,
  "description": "bilirec VictoriaLogs 日誌分析。房間、模組、級別與主機可多選組合，並可用搜尋欄輸入額外 LogsQL 條件；原始日誌瀏覽請使用 bilirec-logs-explorer。",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "label": "日誌資料源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "metricsDatasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "指標資料源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "room",
        "type": "query",
        "label": "房間",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "room",
          "query": "app:bilirec room:*",
          "limit": 500
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "logger",
        "type": "query",
        "label": "模組",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "logger",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "level",
        "type": "query",
        "label": "級別",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "level",
          "query": "app:bilirec room:in($room)",
          "limit": 50
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "type": "query",
        "label": "主機",
        "hide": 0,
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "instance",
          "query": "app:bilirec room:in($room)",
          "limit": 100
        },
        "definition": "",
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "全部",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "搜尋（LogsQL）",
        "hide": 0,
        "description": "可輸入額外的 LogsQL 條件，例如 error、file:xxx 或 processor:convert。",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "bilirec"
      ],
      "targetBlank": false,
      "title": "bilirec",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "總覽",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "選定範圍日誌",
      "description": "依頂欄房間、模組、級別、主機與搜尋條件統計。",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:in($logger) level:in($level) instance:in($instance) $search | stats count() as count",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "錯誤日誌",

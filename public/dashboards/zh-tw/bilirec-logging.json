            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "app:bilirec room:in($room) logger:in($logger) level:in($level) instance:in($instance) $search | stats count_uniq(room) as rooms",
          "queryType": "stats"

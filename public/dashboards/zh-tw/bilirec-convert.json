{
  "title": "bilirec / 轉碼健康",
  "uid": "bilirec-convert",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "bilirec"
  ],
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "id": null,
  "description": "轉碼佇列有沒有積壓、失敗嘗試是否突然變多，以及 FFmpeg 與 CloudConvert 各處理了多少。「失敗」按嘗試次數計，重試會重複累加。CloudConvert 的「待處理」是尚未成功提交到雲端，「處理中」是已提交但仍在雲端等待、執行或下載結果。碼率與錄製請看「錄製總覽」或「錄製健康」。",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "資料源",
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "type": "query",
        "label": "job",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total, job)",
        "definition": "label_values(bilirec_convert_tasks_queued_total, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "label": "instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\"}, instance)",
        "definition": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\"}, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "type": "query",
        "label": "provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\"}, provider)",
        "definition": "label_values(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\"}, provider)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "bilirec"
      ],
      "targetBlank": false,
      "title": "bilirec",
      "tooltip": "",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "現況",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "處理中",
      "description": "當前仍在處理生命週期中的任務數。FFmpeg 表示正在轉碼；CloudConvert 表示已提交到雲端但仍保留在持久化佇列中的任務，包含雲端等待、執行及結果下載處理。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}) or vector(0)",
          "legendFormat": "處理中",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "待處理",
      "description": "當前仍在本機等待下一步動作的任務數。FFmpeg 是尚未開始或等待重試的任務；CloudConvert 是尚未成功提交到雲端的任務。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}) or vector(0)",
          "legendFormat": "待處理",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "入隊",
      "description": "所選時間區間內成功寫入轉碼佇列的任務數。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "入隊",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "完成",
      "description": "所選時間區間內成功完成的轉碼任務數。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "完成",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "失敗嘗試",
      "description": "所選時間區間內轉碼或相關處理失敗的次數。任務重試時可能重複計數，因此不一定等於唯一失敗任務數。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "失敗",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "取消",
      "description": "所選時間區間內由使用者取消、併成功從佇列移除的任務數。",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bilirec_convert_tasks_cancelled_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "取消",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "積壓與失敗率",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "stat",
      "title": "區間失敗率",
      "description": "失敗嘗試 ÷（完成 + 失敗嘗試）。分母不含取消。重試會抬高此值，不等於唯一任務失敗比例。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)) / clamp_min((sum(increase(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)) + (sum(increase(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__range])) or vector(0)), 1)",
          "legendFormat": "失敗率",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "FFmpeg 積壓",
      "description": "當前 FFmpeg 待處理 + 處理中。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=\"ffmpeg\"}) or vector(0)) + (sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=\"ffmpeg\"}) or vector(0))",
          "legendFormat": "FFmpeg",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "CloudConvert 積壓",
      "description": "當前 CloudConvert 待處理 + 處理中（含已提交雲端尚未結束）。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=\"cloudconvert\"}) or vector(0)) + (sum(bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=\"cloudconvert\"}) or vector(0))",
          "legendFormat": "CloudConvert",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "各實例積壓",
      "description": "按 instance、provider 看當前待處理與處理中。沒任務時為空表。",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, provider) (bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, provider) (bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "processing"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "provider",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "filterable": true
          }
        }
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "趨勢",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "待處理與處理中",
      "description": "按 provider 顯示等待下一步動作及仍在處理生命週期中的任務數。CloudConvert 的處理中包括雲端等待、執行及結果下載處理。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (bilirec_convert_tasks_pending{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "{{provider}} / 待處理"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (bilirec_convert_tasks_processing{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"})",
          "legendFormat": "{{provider}} / 處理中"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "入隊速率（按 provider）",
      "description": "成功寫入轉碼佇列的平均速率。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_queued_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 3,
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "處理結果速率",
      "description": "按 provider 與結果顯示每秒平均事件數。失敗按嘗試次數計數，重試可能讓同一任務出現多次失敗。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_completed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 完成"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_failed_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 失敗"
        },
        {
          "refId": "C",
          "expr": "sum by (provider) (rate(bilirec_convert_tasks_cancelled_total{job=~\"$job\", instance=~\"$instance\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / 取消"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 3,
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",

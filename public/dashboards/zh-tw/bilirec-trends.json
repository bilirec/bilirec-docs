      {
        "id": 22,
        "type": "stat",
        "title": "可用空間",
        "description": "優先用 ZFS（node_exporter 的 zfs/fuse.zfs，或 zfs_exporter）。沒有 ZFS 才用下方掛載點的 node_exporter。都沒有則無資料。同一 pool 多個資料集只取最大值，不相加。",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 44 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"})",
            "legendFormat": "可用",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10737418240 },
                { "color": "green", "value": 107374182400 }
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 23,
        "type": "stat",
        "title": "每日平均寫入",
        "description": "這段總寫入（錄製 + 彈幕）÷ 天數。不是「每日寫入」圖各點的平均；那些點是往回 24 小時，不是日曆日。時間範圍太短會晃，建議至少 7 天。不含系統或其他程式。",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 44 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "((sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) + (sum(increase(bilirec_danmaku_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) or vector(0))) * 86400 / $__range_s) or vector(0)",
            "legendFormat": "每天",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },

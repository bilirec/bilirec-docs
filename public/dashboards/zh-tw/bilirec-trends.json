{
    "title": "bilirec / 用量趨勢",
    "uid": "bilirec-trends",
    "schemaVersion": 39,
    "version": 14,
    "refresh": "1m",
    "tags": ["bilirec"],
    "timezone": "browser",
    "graphTooltip": 1,
    "editable": true,
    "id": null,
    "description": "上方 KPI 是這段總增量再換成「平均每」。中間走勢圖每個點是該時刻往回 24 小時的增量（不是日曆日 0:00–24:00），請選至少 7 天。磁碟虛線用時間選單這段歷史做迴歸，並畫進右側「預測未來」。可用空間優先 ZFS，沒有再退回 node_exporter。",
    "time": { "from": "now-7d", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "label": "資料源",
          "hide": 0,
          "refresh": 1,
          "includeAll": false,
          "multi": false
        },
        {
          "name": "job",
          "type": "query",
          "label": "job",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(bilirec_active_recordings, job)",
          "definition": "label_values(bilirec_active_recordings, job)",
          "includeAll": true,
          "multi": true,
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "instance",
          "type": "query",
          "label": "instance",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(bilirec_active_recordings{job=~\"$job\"}, instance)",
          "definition": "label_values(bilirec_active_recordings{job=~\"$job\"}, instance)",
          "includeAll": true,
          "multi": true,
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "room_id",
          "type": "query",
          "label": "房間",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "query_result(max by (room_id, uname) (bilirec_room_info{job=~\"$job\", instance=~\"$instance\"}))",
          "definition": "query_result(max by (room_id, uname) (bilirec_room_info{job=~\"$job\", instance=~\"$instance\"}))",
          "regex": "/room_id=\"(?<value>[^\"]+)\".*uname=\"(?<text>[^\"]+)\"/",
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "per",
          "type": "custom",
          "label": "平均每",
          "query": "小時 : 3600,6小時 : 21600,12小時 : 43200,天 : 86400,7天 : 604800",
          "includeAll": false,
          "multi": false,
          "current": { "selected": true, "text": "天", "value": "86400" },
          "options": [
            { "selected": false, "text": "小時", "value": "3600" },
            { "selected": false, "text": "6小時", "value": "21600" },
            { "selected": false, "text": "12小時", "value": "43200" },
            { "selected": true, "text": "天", "value": "86400" },
            { "selected": false, "text": "7天", "value": "604800" }
          ]
        },
        {
          "name": "topk",
          "type": "custom",
          "label": "Top N",
          "query": "5,10,20,50",
          "includeAll": false,
          "multi": false,
          "current": { "selected": true, "text": "10", "value": "10" },
          "options": [
            { "selected": false, "text": "5", "value": "5" },
            { "selected": true, "text": "10", "value": "10" },
            { "selected": false, "text": "20", "value": "20" },
            { "selected": false, "text": "50", "value": "50" }
          ]
        },
        {
          "name": "node_job",
          "type": "query",
          "label": "node job",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(node_filesystem_avail_bytes, job)",
          "definition": "label_values(node_filesystem_avail_bytes, job)",
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "node_instance",
          "type": "query",
          "label": "node instance",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(node_filesystem_avail_bytes{job=~\"$node_job\"}, instance)",
          "definition": "label_values(node_filesystem_avail_bytes{job=~\"$node_job\"}, instance)",
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "refresh": 2,
          "sort": 1,
          "current": { "selected": true, "text": "All", "value": "$__all" }
        },
        {
          "name": "mountpoint",
          "type": "query",
          "label": "掛載點（無 ZFS 時）",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "label_values(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"}, mountpoint)",
          "definition": "label_values(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"}, mountpoint)",
          "includeAll": false,
          "multi": false,
          "refresh": 2,
          "sort": 1
        },
        {
          "name": "disk_ahead",
          "type": "custom",
          "label": "預測未來",
          "query": "7 天 : 7,14 天 : 14,30 天 : 30,半年 : 180,1 年 : 365,3 年 : 1095",
          "includeAll": false,
          "multi": false,
          "hide": 0,
          "current": { "selected": true, "text": "30 天", "value": "30" },
          "options": [
            { "selected": false, "text": "7 天", "value": "7" },
            { "selected": false, "text": "14 天", "value": "14" },
            { "selected": true, "text": "30 天", "value": "30" },
            { "selected": false, "text": "半年", "value": "180" },
            { "selected": false, "text": "1 年", "value": "365" },
            { "selected": false, "text": "3 年", "value": "1095" }
          ]
        },
        {
          "name": "disk_range",
          "type": "query",
          "label": "",
          "hide": 2,
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "query": "query_result(clamp_min(ceil($__range_s / 86400), 1))",
          "definition": "query_result(clamp_min(ceil($__range_s / 86400), 1))",
          "regex": "/(?<value>\\d{1,5})/",
          "includeAll": false,
          "multi": false,
          "refresh": 2,
          "sort": 0,
          "current": { "selected": true, "text": "7", "value": "7" }
        }
      ]
    },
    "links": [
      {
        "asDropdown": true,
        "icon": "dashboard",
        "includeVars": true,
        "keepTime": true,
        "tags": ["bilirec"],
        "targetBlank": false,
        "title": "bilirec",
        "tooltip": "",
        "type": "dashboards"
      }
    ],
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "平均每${per:text}",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 2,
        "type": "stat",
        "title": "錄製房間數",
        "description": "每個「平均每」時段裡，只要錄過就算 1 個房間，不看錄了多久。再對這些時段取平均。選「天」時就是平均每天錄過幾個房間。",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "avg_over_time((count(max by (room_id) (max_over_time(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[${per}s])) > 0) or vector(0))[$__range:${per}s])",
            "legendFormat": "房間",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "錄製房間比例",
        "description": "平均每時段錄過的房間數 ÷ 同期開播過的房間數。例如 4 個開播、3 個有錄，就是 75%。沒人開播時為 0。",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "WITH (rec = avg_over_time((count(max by (room_id) (max_over_time(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[${per}s])) > 0) or vector(0))[$__range:${per}s]), live = avg_over_time((count(max by (room_id) (max_over_time(bilirec_room_live_status{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[${per}s])) > 0) or vector(0))[$__range:${per}s])) ((rec / live) if (live > 0)) default 0",
            "legendFormat": "比例",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "錄製寫入",
        "description": "這段總寫入再換成平均每${per:text}，約等於落盤。",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) * $per / $__range_s) or vector(0)",
            "legendFormat": "錄製",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "彈幕寫入",
        "description": "這段總寫入再換成平均每${per:text}的彈幕檔大小。沒開彈幕錄製會是 0。",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(increase(bilirec_danmaku_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) * $per / $__range_s) or vector(0)",
            "legendFormat": "彈幕檔",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "彈幕條數",
        "description": "這段總條數再換成平均每${per:text}收到的彈幕事件數（含後來被丟的）。",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(increase(bilirec_danmaku_messages_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) * $per / $__range_s) or vector(0)",
            "legendFormat": "彈幕",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "開錄場次",
        "description": "每個時段開始錄製的次數加總，再對這些時段取平均。選「天」時就是平均每天開了幾場。同一房間中斷再開會計多次。",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "avg_over_time((sum(increase(bilirec_room_recording_sessions_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[${per}s])) or vector(0))[$__range:${per}s])",
            "legendFormat": "場次",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 8,
        "type": "row",
        "title": "每日走勢",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "每日寫入",
        "description": "每個點是該時刻往回 24 小時的增量，不是日曆日 0:00–24:00。左緣第一個點可能含時間範圍開始之前。和上方 KPI 比時請用「這段總量 ÷ 天數」，不要把幾個點當幾個自然日再平均。時間範圍請至少 7 天。",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
        "interval": "1d",
        "maxDataPoints": 400,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) or vector(0)",
            "legendFormat": "錄製",
            "interval": "1d"
          },
          {
            "refId": "B",
            "expr": "sum(increase(bilirec_danmaku_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) or vector(0)",
            "legendFormat": "彈幕檔",
            "interval": "1d"
          },
          {
            "refId": "C",
            "expr": "(sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) + (sum(increase(bilirec_danmaku_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) or vector(0))) or vector(0)",
            "legendFormat": "合計",
            "interval": "1d"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "spanNulls": true, "showPoints": "always", "pointSize": 7 }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi", "sort": "desc" }
        }
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "每日錄製房間 / 場次",
        "description": "錄製房間數 = 當天只要錄過就算 1 間，不看錄了多久。開錄場次 = 當天開始錄製的次數。一天一個點。",
        "gridPos": { "h": 8, "w": 16, "x": 0, "y": 14 },
        "interval": "1d",
        "maxDataPoints": 400,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "count(max by (room_id) (max_over_time(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) > 0) or vector(0)",
            "legendFormat": "錄製房間數",
            "interval": "1d"
          },
          {
            "refId": "B",
            "expr": "sum(increase(bilirec_room_recording_sessions_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) or vector(0)",
            "legendFormat": "開錄場次",
            "interval": "1d"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "none",
            "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "spanNulls": true, "showPoints": "always", "pointSize": 7 }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "multi" }
        }
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "每日彈幕條數",
        "description": "每一天收到的彈幕事件數。沒開彈幕錄製時為 0。",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
        "interval": "1d",
        "maxDataPoints": 400,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(increase(bilirec_danmaku_messages_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[1d])) or vector(0)",
            "legendFormat": "彈幕",
            "interval": "1d"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "unit": "short",
            "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "spanNulls": true, "showPoints": "always", "pointSize": 7 }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
          "tooltip": { "mode": "single" }
        }
      },
      {
        "id": 13,
        "type": "row",
        "title": "速率",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 14,
        "type": "stat",
        "title": "平均錄製讀取速率",
        "description": "含沒在錄的空檔。錄製中平均碼率通常更高。",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 23 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) / $__range_s) or vector(0)",
            "legendFormat": "讀取",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "Bps",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 15,
        "type": "stat",
        "title": "錄製中平均碼率",
        "description": "區間錄製寫入 ÷ 錄製秒數。沒人在錄時接近 0。",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 23 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(increase(bilirec_room_stream_bytes_total{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])) / clamp_min(sum(integrate(bilirec_room_recording_active{job=~\"$job\", instance=~\"$instance\", room_id=~\"$room_id\"}[$__range])), 1)) or vector(0)",
            "legendFormat": "碼率",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 1,
            "unit": "Bps",
            "thresholds": {
              "mode": "absolute",

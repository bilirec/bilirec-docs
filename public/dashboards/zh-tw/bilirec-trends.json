      {
        "id": 26,
        "type": "stat",
        "title": "按磁碟斜率預估",
        "description": "對可用空間做線性迴歸（deriv）。會算進其他程式、ZFS 快照與刪檔，通常比左邊「只算錄製」更接近真實用完時間。空間在增加（斜率 ≥ 0）時無資料。時間範圍太短會晃，建議維持 7 天。",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 44 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "((max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"})) / clamp_min(-deriv((max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"}))[$__range]), 1e-9)) and (deriv((max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"}))[$__range]) < 0)",
            "legendFormat": "線性",
            "instant": true,
            "range": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "dtdhms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 604800 },
                { "color": "green", "value": 2592000 }
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
        }
      },
      {
        "id": 25,
        "type": "timeseries",
        "title": "可用空間",
        "description": "實線是實際可用空間，跟時間選單這段歷史。虛線用同一段歷史做迴歸，並畫進右側「預測未來」；降到 0 就停止，不會畫成負的。選很長未來、很短歷史時，實線會只佔左邊一小段。預估剩餘時間看上方 KPI。",
        "gridPos": { "h": 7, "w": 24, "x": 0, "y": 48 },
        "timeFrom": "+${disk_range}d+${disk_ahead}d",
        "timeShift": "${disk_range}d",
        "hideTimeOverride": true,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"})",
            "legendFormat": "可用"
          },
          {
            "refId": "B",
            "expr": "range_linear_regression(max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", fstype=~\"zfs|fuse.zfs\"}) or max(zfs_dataset_available_bytes) or max(zfs_available_bytes) or max(node_filesystem_avail_bytes{job=~\"$node_job\", instance=~\"$node_instance\", mountpoint=~\"$mountpoint\", fstype!~\"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|cgroup.*|proc|sysfs|vfat|iso9660\"})) >= 0",
            "legendFormat": "線性趨勢"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "decimals": 3,
            "unit": "bytes",
            "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "linear", "spanNulls": false, "showPoints": "never" }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "線性趨勢" },
              "properties": [
                { "id": "custom.fillOpacity", "value": 0 },
                { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
                { "id": "custom.spanNulls", "value": false },
                { "id": "custom.lineWidth", "value": 2 },
                { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
              ]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["min", "lastNotNull"] },
          "tooltip": { "mode": "multi" }
        }
      }
